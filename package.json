{
  "name": "alectra-outage-ts",
  "version": "0.1.0",
  "description": "Experimental, unofficial TypeScript client for Alectra's public outage map",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikifar2012/alectra-outage-ts.git"
  },
  "homepage": "https://github.com/ikifar2012/alectra-outage-ts#readme",
  "bugs": {
    "url": "https://github.com/ikifar2012/alectra-outage-ts/issues"
  },
  "aiGenerated": {
    "value": true,
    "tool": "OpenAI Codex",
    "notice": "Review the code and behavior before production use."
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format esm --minify",
    "check": "tsc --noEmit",
    "prepack": "bun run check && bun run build"
  },
  "keywords": [
    "alectra",
    "ai-generated",
    "electricity",
    "outage",
    "outage-map",
    "arcgis",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
